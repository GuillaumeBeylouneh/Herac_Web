---
const base = import.meta.env.BASE_URL;

const photos = [
  { src: `${base}/photos/lucie-medailles.jpg`, alt: 'Lucie BEYLOUNEH — Médailles' },
  { src: `${base}/photos/ambiance-spartan.jpg`, alt: 'HERAC — Spartan Race' },
  { src: `${base}/photos/galerie-03.jpg`, alt: 'Lucie et Julien — HYROX' },
  { src: `${base}/photos/galerie-04.jpg`, alt: 'Julien CHEVALIER — Soulevé de terre' },
  { src: `${base}/photos/galerie-05.jpg`, alt: 'Julien CHEVALIER — HYROX' },
  { src: `${base}/photos/galerie-06.jpg`, alt: 'HERAC — HYROX Sandbag' },
  { src: `${base}/photos/galerie-07.jpg`, alt: 'Julien CHEVALIER — HYROX' },
  { src: `${base}/photos/galerie-08.jpg`, alt: 'Lucie BEYLOUNEH — HYROX Sandbag' },
  { src: `${base}/photos/galerie-09.jpg`, alt: 'Lucie BEYLOUNEH — HYROX' },
];
---

<section id="galerie" class="py-24 bg-herac-dark">
  <div class="max-w-6xl mx-auto px-4">
    <div class="mb-16">
      <p class="text-herac-red text-xs uppercase tracking-widest font-bold mb-3">Sur le terrain</p>
      <h2 class="font-display text-4xl md:text-6xl text-white tracking-wide">GALERIE</h2>
      <div class="w-16 h-1 bg-herac-red mt-4"></div>
    </div>

    <!-- Mobile : grille 2 colonnes uniformes (pas de layout éditorial complexe) -->
    <div class="grid grid-cols-2 gap-2 sm:hidden">
      {photos.map(photo => (
        <div class="aspect-[4/3] group relative overflow-hidden">
          <img
            src={photo.src}
            alt={photo.alt}
            class="w-full h-full object-cover object-center group-hover:scale-105 transition-transform duration-500"
            loading="lazy"
            decoding="async"
          />
          <div class="absolute inset-0 bg-black/0 group-hover:bg-black/30 transition-colors duration-300" />
        </div>
      ))}
    </div>

    <!-- Desktop : layout éditorial (sm+) -->
    <div class="hidden sm:block space-y-2">

      <!-- Bloc principal : 4 petites (gauche 2/3) + 1 grande (droite 1/3) -->
      <div class="grid grid-cols-3 gap-2">

        <!-- Gauche col-span-2 : 2×2 petites photos -->
        <div class="col-span-2 grid grid-cols-2 gap-2">
          {photos.slice(0, 4).map(photo => (
            <div class="aspect-[4/3] group relative overflow-hidden">
              <img
                src={photo.src}
                alt={photo.alt}
                class="w-full h-full object-cover object-center group-hover:scale-105 transition-transform duration-500"
                loading="lazy"
                decoding="async"
              />
              <div class="absolute inset-0 bg-black/0 group-hover:bg-black/30 transition-colors duration-300" />
            </div>
          ))}
        </div>

        <!-- Droite col-span-1 : grande photo, hauteur = bloc gauche (CSS grid stretch) -->
        <div class="col-span-1 relative overflow-hidden group">
          <img
            src={photos[4].src}
            alt={photos[4].alt}
            class="absolute inset-0 w-full h-full object-cover object-center group-hover:scale-105 transition-transform duration-500"
            loading="lazy"
            decoding="async"
          />
          <div class="absolute inset-0 bg-black/0 group-hover:bg-black/30 transition-colors duration-300" />
        </div>

      </div>

      <!-- Rangée basse : 4 photos égales -->
      <div class="grid grid-cols-4 gap-2">
        {photos.slice(5).map(photo => (
          <div class="aspect-[4/3] group relative overflow-hidden">
            <img
              src={photo.src}
              alt={photo.alt}
              class="w-full h-full object-cover object-center group-hover:scale-105 transition-transform duration-500"
              loading="lazy"
              decoding="async"
            />
            <div class="absolute inset-0 bg-black/0 group-hover:bg-black/30 transition-colors duration-300" />
          </div>
        ))}
      </div>

    </div>

    <!-- CTA Instagram — inchangé -->
    <div class="mt-16 border-t border-white/10 pt-12 flex flex-col sm:flex-row items-center justify-between gap-6">
      <div>
        <p class="text-gray-400 text-sm mb-1">Retrouvez toutes nos photos et vidéos de compétition sur Instagram.</p>
        <p class="text-white font-medium">@herac_officiel</p>
      </div>
      <a
        href="https://instagram.com/herac_officiel"
        target="_blank"
        rel="noopener noreferrer"
        class="inline-flex items-center gap-3 bg-herac-red text-white px-8 py-4 text-sm uppercase tracking-widest font-bold hover:bg-red-700 transition-colors flex-shrink-0"
      >
        <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24">
          <path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zm0-2.163c-3.259 0-3.667.014-4.947.072-4.358.2-6.78 2.618-6.98 6.98-.059 1.281-.073 1.689-.073 4.948 0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98 1.281.058 1.689.072 4.948.072 3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98-1.281-.059-1.69-.073-4.949-.073zm0 5.838c-3.403 0-6.162 2.759-6.162 6.162s2.759 6.163 6.162 6.163 6.162-2.759 6.162-6.163c0-3.403-2.759-6.162-6.162-6.162zm0 10.162c-2.209 0-4-1.79-4-4 0-2.209 1.791-4 4-4s4 1.791 4 4c0 2.21-1.791 4-4 4zm6.406-11.845c-.796 0-1.441.645-1.441 1.44s.645 1.44 1.441 1.44c.795 0 1.439-.645 1.439-1.44s-.644-1.44-1.439-1.44z"/>
        </svg>
        Nous suivre
      </a>
    </div>
  </div>
</section>
