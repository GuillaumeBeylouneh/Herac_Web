---
interface Props {
  from: 'dark' | 'gray' | 'red';
  to: 'dark' | 'gray' | 'red';
  flip?: boolean;
}
const { from, to, flip = false } = Astro.props;

// Hex values from tailwind.config.mjs
const colors: Record<string, string> = {
  dark: '#0D0D0D',
  gray: '#1A1A1A',
  red:  '#C8102E',
};

const fromColor = colors[from];
const toColor = colors[to];
// flip=false: toColor fills bottom-right triangle (polygon: bottom-left, top-right, bottom-right)
// flip=true:  toColor fills top-left triangle    (polygon: top-left, top-right, bottom-left)
const clipPath = flip
  ? 'polygon(0% 0%, 100% 0%, 0% 100%)'
  : 'polygon(0% 100%, 100% 0%, 100% 100%)';
---

<div
  style={`position: relative; background-color: ${fromColor}; height: 48px; margin-bottom: -1px; overflow: hidden;`}
  aria-hidden="true"
>
  <div style={`position: absolute; inset: 0; background-color: ${toColor}; clip-path: ${clipPath};`} />
</div>
