---
import '../styles/global.css';
import Navbar from '../components/Navbar.astro';

interface Props {
  title?: string;
}

const { title = "HERAC - L'excellence physique au service de l'engagement" } = Astro.props;
const base = import.meta.env.BASE_URL;
---

<!doctype html>
<html lang="fr">
  <head>
    <meta charset="UTF-8" />
    <!-- Preload polices auto-hébergées -->
    <link rel="preload" href={`${base}/fonts/BebasNeue-Regular.woff2`} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={`${base}/fonts/Inter-400.woff2`} as="font" type="font/woff2" crossorigin />
    <!-- Preload image hero pour LCP -->
    <link rel="preload" href={`${base}/photos/hero-action.jpg`} as="image" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content="HERAC - Association sportive regroupant des athlètes issus des forces de sécurité intérieure et de défense nationale." />
    <link rel="icon" type="image/png" href={`${base}/logos/logo-herac.png`} />
    <title>{title}</title>
    <!-- SEO Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content={`https://guillaumebeylouneh.github.io${base}/`} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content="HERAC — Association d'athlètes issus des forces de sécurité et de défense. Sport de haut niveau, valeurs militaires. HYROX, Spartan Race, CrossFit." />
    <meta property="og:image" content={`https://guillaumebeylouneh.github.io${base}/og-image.jpg`} />
    <meta property="og:locale" content="fr_FR" />
    <meta property="og:site_name" content="HERAC" />
    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content="HERAC — Association d'athlètes issus des forces de sécurité et de défense." />
    <meta name="twitter:image" content={`https://guillaumebeylouneh.github.io${base}/og-image.jpg`} />
    <!-- JSON-LD SportsOrganization -->
    <script type="application/ld+json" set:text={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "SportsOrganization",
      "name": "HERAC",
      "alternateName": "Héraclès Association Sportive",
      "url": `https://guillaumebeylouneh.github.io${base}/`,
      "logo": `https://guillaumebeylouneh.github.io${base}/logos/logo-herac.png`,
      "description": "Association loi 1901 regroupant des athlètes issus des forces de sécurité intérieure et de défense nationale.",
      "email": "herac.officiel@gmail.com",
      "sameAs": ["https://instagram.com/herac_officiel"],
      "sport": ["HYROX", "Spartan Race", "Coaching sportif", "Secourisme"]
    })} />
  </head>
  <body class="bg-herac-dark text-white">
    <Navbar />
    <main>
      <slot />
    </main>
    <footer class="bg-black py-8 text-center text-gray-500 text-sm">
      <p>© 2025 HERAC — Association loi 1901</p>
      <p class="mt-1">herac.officiel@gmail.com</p>
      <p class="mt-3 text-xs text-gray-600 max-w-2xl mx-auto px-4">
        <strong class="text-gray-500">Mentions légales</strong> — Éditeur&nbsp;: Association HERAC, France. Directeur de publication&nbsp;: Julien CHEVALIER.
        Hébergeur&nbsp;: GitHub, Inc. — 88 Colin P. Kelly Jr. Street, San Francisco, CA 94107, USA.
        Ce site ne collecte aucune donnée personnelle et ne dépose aucun cookie.
      </p>
    </footer>
    <!-- Back to top button -->
    <button
      id="back-to-top"
      aria-label="Retour en haut"
      class="fixed bottom-6 right-6 z-50 w-12 h-12 bg-herac-red text-white flex items-center justify-center opacity-0 pointer-events-none transition-all duration-300 hover:bg-red-700"
    >
      <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 15l7-7 7 7" />
      </svg>
    </button>
    <script>
      const btn = document.getElementById('back-to-top');
      window.addEventListener('scroll', () => {
        if (window.scrollY > 400) {
          btn?.classList.remove('opacity-0', 'pointer-events-none');
          btn?.classList.add('opacity-100');
        } else {
          btn?.classList.add('opacity-0', 'pointer-events-none');
          btn?.classList.remove('opacity-100');
        }
      });
      btn?.addEventListener('click', () => {
        window.scrollTo({ top: 0, behavior: 'smooth' });
      });
    </script>
  </body>
</html>
