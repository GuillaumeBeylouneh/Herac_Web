---
import Layout from '../layouts/Layout.astro';
import Hero from '../components/Hero.astro';
import StatsBar from '../components/StatsBar.astro';
import Association from '../components/Association.astro';
import Palmares from '../components/Palmares.astro';
import Galerie from '../components/Galerie.astro';
import Equipe from '../components/Equipe.astro';
import Services from '../components/Services.astro';
import Sponsoring from '../components/Sponsoring.astro';
import Instagram from '../components/Instagram.astro';
import Contact from '../components/Contact.astro';
import Divider from '../components/Divider.astro';
---

<Layout>
  <Hero />
  <StatsBar />
  <Divider from="red" to="dark" />
  <Association />
  <Divider from="dark" to="gray" />
  <Palmares />
  <Divider from="gray" to="dark" flip={true} />
  <Galerie />
  <Equipe />
  <Divider from="dark" to="gray" />
  <Services />
  <Divider from="gray" to="dark" flip={true} />
  <Sponsoring />
  <Instagram />
  <Divider from="dark" to="gray" />
  <Contact />
</Layout>
