---
import Layout from '../layouts/Layout.astro';
const base = import.meta.env.BASE_URL;
---

<Layout title="404 — Page introuvable | HERAC">
  <section class="min-h-screen flex items-center justify-center bg-herac-dark px-4 pt-16">
    <div class="text-center max-w-lg">
      <p class="font-display text-9xl text-herac-red leading-none mb-4">404</p>
      <h1 class="font-display text-3xl text-white tracking-wide mb-4">PAGE INTROUVABLE</h1>
      <p class="text-gray-400 mb-8">Cette page n'existe pas ou a été déplacée.</p>
      <a
        href={`${base}/`}
        class="bg-herac-red text-white px-8 py-4 text-sm uppercase tracking-widest font-bold hover:bg-red-700 transition-colors"
      >
        Retour à l'accueil
      </a>
    </div>
  </section>
</Layout>
